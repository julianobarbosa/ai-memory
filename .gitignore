# Rust build artefacts.
/target/
/companions/*/target/
/dist/
**/*.rs.bk
**/*.rs.orig

# Local environment overrides.
.env
.env.local
/.local-data/

# Homelab deploy config — committed as .example variants only.
/bin/deploy.env
/docker/docker-compose.prod.yml
/docker/.env.production

# Editor / OS noise.
.DS_Store
*.tmp
*.swp
*.swo
.idea/
.vscode/

# Local debugging.
*.log
flamegraph.svg
perf.data*

# Sandbox marker (not project content).
.ai-jail
.claude/
.codex/
.gemini/
.github/
.slim/deepwork/
_bmad-output/
evals/runs/

# ai-memory atomic-write backups (apply_atomic in apply_shared.rs)
*.bak-*
# BMAD tooling (installed per-session; not project content).
/_bmad/
/.bmad-loop/
/.agent/
/.agents/
# BMAD document-project scan state (regenerated per run).
/docs/project-scan-report.json
.bmad-loop/runs/
.bmad-loop/cache/
.bmad-loop/policy.toml
_bmad/render/
